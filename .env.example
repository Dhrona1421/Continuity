# Continuity core. Copy to .env; never commit the populated file.
GHOSTSOC_ENV=development
GHOSTSOC_SECRET_KEY=change-me-to-at-least-32-random-characters
# Used by Docker Compose for PostgreSQL and the backend connection URL.
POSTGRES_PASSWORD=change-me-to-a-strong-database-password
GHOSTSOC_DATABASE_URL=postgresql+psycopg://ghostsoc:change-me@postgres:5432/ghostsoc
GHOSTSOC_CORS_ORIGINS=http://localhost:8080
GHOSTSOC_BOOTSTRAP_ADMIN_EMAIL=admin@ghostsoc.local
GHOSTSOC_BOOTSTRAP_ADMIN_PASSWORD=change-this-before-non-demo-use
# Set true only when the browser reaches Continuity over HTTPS (required for embedded previews).
GHOSTSOC_SESSION_COOKIE_SECURE=false
# Enable with secure cookies when Continuity is intentionally embedded cross-site.
GHOSTSOC_SESSION_COOKIE_PARTITIONED=false
GHOSTSOC_DRY_RUN=true
GHOSTSOC_DEMO_MODE=true
# Local judge/demo convenience only. Keep false for normal authentication.
GHOSTSOC_DEMO_AUTO_ACCESS=false
GHOSTSOC_AUTHORIZED_TARGETS=demo-endpoint-01,demo-endpoint-02
# Web request ingestion is rejected unless the target is explicitly allowlisted.
GHOSTSOC_WEB_ALLOWED_HOSTS=demo-web.local,authorized-web.test
GHOSTSOC_REPORT_DIR=/var/lib/ghostsoc/reports
GHOSTSOC_EVIDENCE_DIR=/var/lib/ghostsoc/evidence

# Optional Groq inference endpoint. Groq reasons over current evidence and Hindsight-recalled experience.
# No configured provider = AI Recommendation unavailable, not a simulated AI answer.
GHOSTSOC_LLM_BASE_URL=https://api.groq.com/openai/v1
GHOSTSOC_LLM_API_KEY=
GHOSTSOC_LLM_MODEL=openai/gpt-oss-120b
GHOSTSOC_LLM_TIMEOUT_SECONDS=15

# Hindsight organizational memory (optional; absent means visibly unavailable).
# Point at an authorized Hindsight server. Keep API key private; use a dedicated bank per organization.
GHOSTSOC_HINDSIGHT_URL=
GHOSTSOC_HINDSIGHT_API_KEY=
GHOSTSOC_HINDSIGHT_BANK_ID=ghostsoc-security
# Synchronous fact extraction may take tens of seconds on a real server.
GHOSTSOC_HINDSIGHT_TIMEOUT_SECONDS=60
# Optional self-hosted Hindsight container (docker compose --profile memory up -d).
# It requires a real LLM provider key for fact extraction; do not commit the value.
HINDSIGHT_API_LLM_API_KEY=

# OpenSearch core search adapter
GHOSTSOC_OPENSEARCH_URL=http://opensearch:9200
GHOSTSOC_OPENSEARCH_USERNAME=
GHOSTSOC_OPENSEARCH_PASSWORD=
GHOSTSOC_OPENSEARCH_VERIFY_TLS=true

# Optional connector endpoints. HTTPS is required unless private connectors are explicitly allowed.
GHOSTSOC_ALLOW_PRIVATE_CONNECTORS=true
GHOSTSOC_WAZUH_URL=
GHOSTSOC_WAZUH_TOKEN=
GHOSTSOC_VELOCIRAPTOR_URL=
GHOSTSOC_VELOCIRAPTOR_TOKEN=
GHOSTSOC_ARKIME_URL=
GHOSTSOC_MISP_URL=
GHOSTSOC_MISP_API_KEY=
GHOSTSOC_OPENCTI_URL=
GHOSTSOC_OPENCTI_TOKEN=
GHOSTSOC_SHUFFLE_URL=
GHOSTSOC_SHUFFLE_API_KEY=

# Optional CTI API keys. Empty keys leave providers NOT_CONFIGURED.
# One abuse.ch Auth-Key is used by ThreatFox, URLhaus, and MalwareBazaar.
GHOSTSOC_ABUSE_CH_AUTH_KEY=
GHOSTSOC_ABUSEIPDB_API_KEY=
GHOSTSOC_VIRUSTOTAL_API_KEY=
